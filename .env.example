MYSQL_DATABASE=diy_bracelet
MYSQL_USER=diy_bracelet
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3306
REDIS_PORT=6379

BACKEND_PORT=8081
# 默认仅本机访问；真机联调可临时设为 0.0.0.0，配合强密钥和防火墙限制来源。
BACKEND_ADDRESS=127.0.0.1

# 待支付订单期限与到期扫描间隔（ISO-8601 Duration）
ORDER_PAYMENT_TIMEOUT=PT30M
ORDER_EXPIRY_SCAN_DELAY=PT30S
ORDER_EXPIRY_ENABLED=true
JWT_SECRET=replace-with-at-least-32-characters
JWT_TTL=PT8H
JWT_ISSUER=diy-bracelet-mall
CUSTOMER_JWT_SECRET=replace-with-at-least-32-customer-characters
CUSTOMER_JWT_TTL=P30D
CUSTOMER_JWT_ISSUER=diy-bracelet-customer
CUSTOMER_IDENTITY_PEPPER=replace-with-at-least-32-pepper-characters
# Base64 编码的 32 字节 AES 主密钥；请在源码仓库外生成和保管。
AI_CONFIG_ENCRYPTION_KEY=
# 单进程模型调用并发上限（1 至 32），同一顾客同时只能请求一次。
AI_MAX_CONCURRENT_REQUESTS=4
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
FILE_STORAGE_MAX_SIZE_BYTES=5000000
FILE_STORAGE_LOCAL_ROOT=../storage/catalog
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8081/api
