@import "./common.wxss";
.favorite-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18rpx; margin-top:30rpx; }.favorite-card { position:relative; display:flex; min-width:0; flex-direction:column; align-items:center; padding:24rpx 18rpx 20rpx; }.favorite-card image { width:180rpx; height:180rpx; }.favorite-card strong { display:block; max-width:100%; margin-top:13rpx; overflow:hidden; font-size:26rpx; text-overflow:ellipsis; white-space:nowrap; }.favorite-card > text { max-width:100%; margin-top:7rpx; overflow:hidden; color:#938087; font-size:18rpx; text-overflow:ellipsis; white-space:nowrap; }.favorite-card .price { color:#b34c76; font-size:22rpx; font-weight:600; }
.heart-button { position:absolute; z-index:2; top:14rpx; right:14rpx; width:54rpx; height:54rpx; padding:0; border-radius:50%; color:#e56597; font-size:30rpx; line-height:54rpx; background:#fff0f5; }.design-button { width:100%; height:58rpx; margin-top:16rpx; border-radius:29rpx; color:#fff; font-size:21rpx; line-height:58rpx; background:#bd527d; }.browse-button { width:300rpx; margin:26rpx auto 0; }
