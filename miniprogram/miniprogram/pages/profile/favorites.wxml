<view class="subpage favorites-page">
  <text class="page-kicker">MY FAVORITES</text><text class="page-title">我的收藏</text><text class="page-subtitle">把心动的珠子留在这里，随时加入下一条手串</text>
  <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
  <view wx:if="{{loading}}" class="soft-card state-card">正在整理收藏…</view>
  <view wx:elif="{{!favoriteCards.length}}" class="soft-card state-card"><text>还没有收藏珠子</text><button class="secondary-action browse-button" bindtap="browseBeads">去 DIY 里发现心动</button></view>
  <view wx:else class="favorite-grid">
    <view wx:for="{{favoriteCards}}" wx:key="id" class="soft-card favorite-card">
      <button class="heart-button" data-id="{{item.id}}" bindtap="removeFavorite">♥</button><image src="{{item.imageUrl}}" mode="aspectFit" /><strong>{{item.title}}</strong><text>{{item.specification}}</text><text class="price">{{item.priceText}}</text><button class="design-button" data-id="{{item.id}}" bindtap="startDesign">加入 DIY</button>
    </view>
  </view>
</view>
