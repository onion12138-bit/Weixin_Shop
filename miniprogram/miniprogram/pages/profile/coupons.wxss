@import "./common.wxss";
.status-tabs { display:flex; gap:12rpx; margin:30rpx 0 26rpx; }.status-tabs button { height:62rpx; flex:1; padding:0; border-radius:31rpx; color:#8c727d; font-size:21rpx; line-height:62rpx; background:#f7e9ee; }.status-tabs button.active { color:#fff; background:#b94d7a; }
.coupon-list { display:flex; flex-direction:column; gap:20rpx; }.coupon-card { position:relative; display:grid; grid-template-columns:190rpx 1fr; min-height:190rpx; overflow:hidden; }.coupon-card::before,.coupon-card::after { position:absolute; left:178rpx; width:26rpx; height:26rpx; border-radius:50%; background:#fff8fa; content:""; }.coupon-card::before { top:-13rpx; }.coupon-card::after { bottom:-13rpx; }
.coupon-value { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:22rpx 14rpx; color:#b94274; text-align:center; background:linear-gradient(145deg,#ffdce9,#fff0f4); }.coupon-value .strong-text { font-size:48rpx; }.coupon-value text { margin-top:8rpx; font-size:18rpx; }
.coupon-content { padding:28rpx 24rpx; border-left:2rpx dashed #f0cad8; }.coupon-heading { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.coupon-heading .strong-text { font-size:27rpx; }.coupon-heading .badge-text { padding:5rpx 11rpx; border-radius:14rpx; color:#b94274; font-size:18rpx; font-style:normal; background:#fde8f0; }.coupon-description,.coupon-date,.coupon-note { display:block; }.coupon-description { margin-top:12rpx; color:#746169; font-size:21rpx; line-height:1.5; }.coupon-date { margin-top:15rpx; color:#a18d95; font-size:19rpx; }.coupon-note { margin-top:7rpx; color:#c06389; font-size:18rpx; }
.coupon-card.inactive { filter:grayscale(.45); opacity:.68; }
.coupon-card { grid-template-columns: 190rpx minmax(0, 1fr); }.coupon-content { min-width: 0; }
.coupon-heading { align-items: flex-start; }.coupon-heading .strong-text { min-width: 0; flex: 1; word-break: break-all; }.coupon-heading .badge-text { flex: 0 0 auto; white-space: nowrap; }
.coupon-description,.coupon-note,.coupon-value { word-break: break-all; }
.coupon-value .strong-text { margin-top: 0; }
