<view class="detail-page">
  <view wx:if="{{loading}}" class="page-state">正在加载订单…</view>
  <view wx:elif="{{errorMessage && !order}}" class="page-state error-state">
    <text>{{errorMessage}}</text>
    <button bindtap="loadOrder">重新加载</button>
  </view>

  <block wx:elif="{{order}}">
    <view class="status-hero {{order.statusClass}}">
      <text class="kicker">ORDER STATUS</text>
      <text class="status-title">{{order.statusText}}</text>
      <text class="order-no">{{order.orderNo}}</text>
      <text class="order-date">{{order.createdAtText}} 创建</text>
    </view>

    <view wx:if="{{order.status === 'PENDING_PAYMENT' && expiresAtText}}" class="detail-card">
      <text>{{paymentExpired ? '支付期限已到，正在等待关单结果' : '请在 ' + countdownText + ' 内完成支付'}}</text>
      <text>付款截止：{{expiresAtText}}</text>
      <text>到期自动释放库存与优惠券占用</text>
      <button wx:if="{{paymentExpired}}" bindtap="loadOrder">刷新订单状态</button>
    </view>
    <view wx:if="{{closedReasonText}}" class="detail-card">{{closedReasonText}}</view>

    <view wx:if="{{order.status !== 'CANCELLED' && order.status !== 'AFTER_SALE' && order.status !== 'REFUNDED'}}" class="progress-card">
      <view wx:for="{{steps}}" wx:key="*this" class="step {{index <= order.progressIndex ? 'active' : ''}}">
        <view class="step-dot">{{index + 1}}</view>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="detail-card">
      <text class="card-title">收货信息</text>
      <text>{{order.contactName}} · {{order.contactPhone}}</text>
      <text>{{order.addressDetail}}</text>
    </view>

    <view class="detail-card logistics-card">
      <view class="card-heading">
        <text class="card-title">物流信息</text>
        <button wx:if="{{order.trackingNo}}" bindtap="copyTrackingNo">复制单号</button>
      </view>
      <text>{{order.logisticsCompany || '物流公司待更新'}}</text>
      <text>{{order.trackingNo || '暂未提供运单号，请等待物流更新'}}</text>
    </view>

    <view class="detail-card">
      <view class="card-heading">
        <text class="card-title">制作清单</text>
        <text>{{order.beadCountText}}</text>
      </view>
      <view wx:for="{{order.items}}" wx:key="skuId" class="bom-row">
        <view>
          <text>{{item.name}}</text>
          <text>{{item.skuCode}}</text>
        </view>
        <text>{{item.quantityText}}</text>
        <text>{{item.totalPriceText}}</text>
      </view>
    </view>

    <view class="detail-card amount-card">
      <view><text>珠子金额</text><text>{{order.beadAmountText}}</text></view>
      <view><text>工艺费</text><text>{{order.craftFeeText}}</text></view>
      <view><text>绳材加价</text><text>{{order.cordFeeText}}</text></view>
      <view wx:if="{{order.discountAmount}}"><text>优惠券抵扣</text><text>{{order.discountAmountText}}</text></view>
      <view><text>配送费</text><text>{{order.shippingFeeText}}</text></view>
      <view class="total-row"><text>订单总额</text><text class="strong-text">{{order.amountText}}</text></view>
    </view>

    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>

    <view wx:if="{{order.canMockPay || order.canCancel || order.canConfirmReceipt}}" class="action-bar">
      <button
        wx:if="{{order.canCancel}}"
        loading="{{operating}}"
        disabled="{{operating}}"
        class="secondary-action"
        bindtap="cancel"
      >
        取消订单
      </button>
      <button
        wx:if="{{order.canMockPay}}"
        loading="{{operating}}"
        disabled="{{operating}}"
        class="primary-action"
        bindtap="mockPay"
      >
        模拟支付
      </button>
      <button
        wx:if="{{order.canConfirmReceipt}}"
        loading="{{operating}}"
        disabled="{{operating}}"
        class="primary-action"
        bindtap="confirmReceipt"
      >
        确认收货
      </button>
    </view>
  </block>
</view>
