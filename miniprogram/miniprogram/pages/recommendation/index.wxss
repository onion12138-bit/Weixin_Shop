.recommendation-page {
  min-height: 100vh;
  padding: 30rpx 30rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff8fa;
}

.consultation-hero {
  position: relative;
  display: flex;
  min-height: 360rpx;
  overflow: hidden;
  padding: 46rpx 38rpx;
  border-radius: 30rpx;
  color: #3c284e;
  background: #e9e2f0;
}

.wish-hero-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 430rpx;
}

.eyebrow,
.section-kicker {
  display: block;
  color: #765b84;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-family: "Songti SC", serif;
  font-size: 45rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-summary {
  display: block;
  margin-top: 20rpx;
  color: #685370;
  font-size: 23rpx;
  line-height: 1.7;
}

.state-card,
.form-card,
.plan-card {
  margin-top: 28rpx;
  padding: 38rpx 32rpx;
  border: 1rpx solid #e8dfda;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 16rpx 42rpx rgba(75, 54, 61, .06);
}

.state-card {
  color: #6d6065;
  text-align: center;
}

.state-title,
.state-copy {
  display: block;
}

.state-title {
  color: #4a3b41;
  font-size: 30rpx;
  font-weight: 700;
}

.state-copy {
  margin-top: 16rpx;
  font-size: 23rpx;
}

.state-card button {
  width: 240rpx;
  margin-top: 28rpx;
  border-radius: 40rpx;
  color: #fff;
  font-size: 24rpx;
  background: #6d4152;
}

.section-heading {
  margin-bottom: 30rpx;
}

.section-heading .section-kicker,
.results-heading .section-kicker {
  color: #8b6876;
}

.section-title,
.plan-title {
  display: block;
  margin-top: 10rpx;
  color: #382e32;
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
}

.section-note {
  display: block;
  margin-top: 12rpx;
  color: #978a8f;
  font-size: 21rpx;
  line-height: 1.6;
}

.field-group {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 11rpx;
  color: #55484d;
  font-size: 23rpx;
  font-weight: 600;
}

.field-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.field-label-row .field-label {
  margin-bottom: 11rpx;
}

.field-hint {
  color: #a98598;
  font-size: 20rpx;
}

.wish-inspiration-field {
  margin-top: 6rpx;
}

.wish-inspiration-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.wish-inspiration-option {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 142rpx;
  padding: 0;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  line-height: 1;
  background: #fff;
  box-shadow: 0 7rpx 17rpx rgba(163, 108, 137, .11);
}

.wish-inspiration-option::after {
  border: 0;
}

.wish-inspiration-option.is-selected {
  border-color: #dc6f9b;
  box-shadow: 0 8rpx 20rpx rgba(219, 105, 153, .24);
}

.wish-inspiration-option image {
  display: block;
  width: 100%;
  height: 100%;
}

.wish-selected-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 16rpx;
  line-height: 1.3;
  background: #d75f91;
}

.field-group input,
.picker-field,
.field-group textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #ded4cf;
  border-radius: 16rpx;
  color: #352d30;
  font-size: 24rpx;
  background: #fcfaf8;
}

.field-group input,
.picker-field {
  height: 76rpx;
  padding: 0 20rpx;
  line-height: 76rpx;
}

.field-group textarea {
  height: 190rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.placeholder {
  color: #aaa0a4;
}

.profile-state,
.counter {
  display: block;
  margin-top: 10rpx;
  color: #7a9195;
  font-size: 20rpx;
}

.profile-error {
  display: block;
  margin-top: 12rpx;
  color: #a44949;
  font-size: 21rpx;
}

.birth-profile {
  display: grid;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  background: #f3f7f6;
}

.profile-item {
  min-width: 0;
  text-align: center;
}

.profile-label,
.profile-value {
  display: block;
}

.profile-label {
  color: #829296;
  font-size: 18rpx;
}

.profile-value {
  overflow: hidden;
  margin-top: 7rpx;
  color: #45616a;
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counter {
  text-align: right;
}

.form-error {
  display: block;
  margin: 0 0 20rpx;
  color: #a44949;
  font-size: 22rpx;
}

.submit-button,
.diy-button {
  border-radius: 44rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  background: #6d4152;
}

.submitting-state {
  padding: 24rpx;
  color: #7a6970;
  text-align: center;
  font-size: 24rpx;
}

.results-section {
  margin-top: 38rpx;
}

.results-heading {
  padding: 0 8rpx 4rpx;
}

.plan-card {
  margin-top: 24rpx;
}

.plan-number {
  display: block;
  color: #8b6876;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.plan-summary {
  display: block;
  word-break: break-all;
  margin-top: 16rpx;
  color: #71646a;
  font-size: 24rpx;
  line-height: 1.7;
}

.recommendation-items {
  margin-top: 30rpx;
}

.recommendation-item {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee7e3;
}

.recommendation-item image {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 auto;
  border-radius: 18rpx;
  background: #eee7e2;
}

.item-copy {
  min-width: 0;
  word-break: break-all;
  flex: 1;
}

.item-name {
  display: block;
  color: #41363b;
  font-size: 25rpx;
  font-weight: 700;
}

.item-reason {
  display: block;
  margin-top: 12rpx;
  color: #8a7e82;
  font-size: 22rpx;
  line-height: 1.6;
}

.disclaimer {
  display: block;
  margin: 26rpx 8rpx 0;
  color: #968b8f;
  font-size: 20rpx;
  line-height: 1.65;
}

.plan-card .diy-button {
  margin-top: 26rpx;
}

.diy-button {
  margin-top: 28rpx;
  background: #426674;
}
