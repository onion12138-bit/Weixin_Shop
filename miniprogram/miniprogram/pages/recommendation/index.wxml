<view class="recommendation-page">
  <view class="consultation-hero">
    <image
      class="wish-hero-background"
      src="/assets/images/wish-inspiration-hero.png"
      mode="aspectFill"
      aria-label="紫色水晶与月亮心愿灵感插画"
    />
    <view class="hero-copy">
      <text class="eyebrow">AI BRACELET GUIDE</text>
      <text class="hero-title">把此刻的心愿，织进一串日常。</text>
      <text class="hero-summary">选择生日，也可以留下心愿，由 AI 给出多套珠子搭配灵感。</text>
    </view>
  </view>

  <view wx:if="{{statusLoading}}" class="state-card">
    <text>正在确认 AI 推荐服务…</text>
  </view>

  <view wx:elif="{{!available}}" class="state-card unavailable-card">
    <text class="state-title">{{statusMessage}}</text>
    <text class="state-copy">你仍可从首页进入商品目录或直接 DIY。</text>
    <button bindtap="retryStatus">重新检查</button>
  </view>

  <view wx:else class="form-card">
    <view class="section-heading">
      <text class="section-kicker">YOUR PROFILE</text>
      <text class="section-title">描述你的专属灵感</text>
      <text class="section-note">生日、心愿灵感与期望只用于本次推荐，不会保存为草稿。</text>
    </view>

    <view class="field-group">
      <text class="field-label">生日 *</text>
      <picker mode="date" value="{{birthDate}}" end="{{today}}" bindchange="changeBirthDate">
        <view class="picker-field {{birthDate ? '' : 'placeholder'}}">
          {{birthDate || '选择日期'}}
        </view>
      </picker>

      <view wx:if="{{profileLoading}}" class="profile-state">正在解析生日信息…</view>
      <text wx:elif="{{profileError}}" class="profile-error">{{profileError}}</text>
      <view wx:elif="{{profile}}" class="birth-profile">
        <view class="profile-item">
          <text class="profile-label">星座</text>
          <text class="profile-value">{{profile.constellation}}</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">生肖</text>
          <text class="profile-value">{{profile.zodiac}}</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">星座元素</text>
          <text class="profile-value">{{profile.constellationElement}}</text>
        </view>
      </view>
    </view>

    <view class="field-group wish-inspiration-field">
      <view class="field-label-row">
        <text class="field-label">心愿灵感（选填）</text>
        <text class="field-hint">{{wishInspiration || '不选也可以'}}</text>
      </view>
      <view class="wish-inspiration-grid">
        <button
          wx:for="{{wishInspirationOptions}}"
          wx:key="name"
          class="wish-inspiration-option {{wishInspiration === item.name ? 'is-selected' : ''}}"
          data-wish-inspiration="{{item.name}}"
          aria-label="选择{{item.name}}心愿灵感"
          bindtap="selectWishInspiration"
        >
          <image src="{{item.imageUrl}}" mode="aspectFill" aria-label="{{item.name}}" />
          <view wx:if="{{wishInspiration === item.name}}" class="wish-selected-mark">已选</view>
        </button>
      </view>
    </view>

    <view class="field-group">
      <text class="field-label">期望（选填）</text>
      <textarea
        value="{{wish}}"
        maxlength="80"
        placeholder="如：希望日常佩戴时更从容、专注"
        bindinput="updateWish"
      />
      <text class="counter">{{wish.length}} / 80</text>
    </view>

    <text wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</text>
    <button
      wx:if="{{available && !submitting}}"
      class="submit-button"
      bindtap="submitRecommendation"
    >
      生成推荐方案
    </button>
    <view wx:if="{{submitting}}" class="submitting-state">正在生成并校验推荐…</view>
  </view>

  <view wx:if="{{available && result}}" class="results-section">
    <view class="results-heading">
      <text class="section-kicker">CURATED FOR YOU</text>
      <text class="section-title">AI 推荐方案</text>
      <text class="section-note">每套方案展示珠子种类组合，进入 DIY 后可再调整顺序和数量。</text>
    </view>

    <view wx:for="{{result.plans}}" wx:for-item="plan" wx:for-index="planIndex" wx:key="key" class="plan-card">
      <view class="plan-heading">
        <text class="plan-number">{{plan.numberLabel}}</text>
        <text class="plan-title">{{plan.schemeName}}</text>
        <text class="plan-summary">{{plan.summary}}</text>
      </view>

      <view class="recommendation-items">
        <view wx:for="{{plan.items}}" wx:for-item="bead" wx:key="skuId" class="recommendation-item">
          <image src="{{bead.imageUrl}}" mode="aspectFill" />
          <view class="item-copy">
            <text class="item-name">{{bead.name}}</text>
            <text class="item-reason">{{bead.reason}}</text>
          </view>
        </view>
      </view>

      <button
        class="diy-button"
        data-index="{{planIndex}}"
        loading="{{enteringDiy}}"
        disabled="{{enteringDiy}}"
        bindtap="enterDiy"
      >
        使用这套去 DIY
      </button>
    </view>

    <text class="disclaimer">{{result.culturalDisclaimer}}</text>
  </view>
</view>
