<view class="diy-page">
  <view wx:if="{{errorMessage}}" class="page-state error-state">
    <text>{{errorMessage}}</text>
  </view>

  <block wx:else>
    <view class="diy-controls {{previewExpanded ? '' : 'is-sticky'}}">
      <view wx:if="{{!loading}}" class="configuration-strip">
        <picker range="{{wristOptionLabels}}" value="{{wristOptionIndex}}" bindchange="changeWrist">
          <button>腕围 {{wristCircumferenceText}}</button>
        </picker>
        <picker range="{{fitTypeLabels}}" value="{{fitTypeIndex}}" bindchange="changeFitType">
          <button>{{fitTypeLabels[fitTypeIndex]}}</button>
        </picker>
        <picker range="{{cordOptionNames}}" value="{{cordOptionIndex}}" bindchange="changeCord">
          <button>{{cordOptionNames[cordOptionIndex]}}</button>
        </picker>
      </view>

      <view class="canvas-panel {{previewExpanded ? 'is-expanded' : 'is-collapsed'}} {{loading ? 'is-loading' : ''}}">
        <view class="preview-layout">
          <view class="bracelet-canvas-viewport">
            <canvas
              id="bracelet-canvas"
              type="2d"
              class="bracelet-canvas"
              hidden="{{!previewExpanded}}"
              bindtouchstart="onCanvasTouchStart"
              bindtouchmove="onCanvasTouchMove"
              bindtouchend="onCanvasTouchEnd"
            />
            <image
              wx:if="{{!previewExpanded && compactPreviewUrl}}"
              class="compact-preview-image"
              src="{{compactPreviewUrl}}"
              mode="aspectFit"
            />
            <cover-view hidden="{{loading}}" class="preview-toolbar">
              <cover-view class="preview-toggle" bindtap="togglePreview" aria-label="{{previewExpanded ? '收起预览' : '展开预览'}}">
                <cover-view class="preview-toggle-label">{{previewExpanded ? '收起预览' : '展开预览'}}</cover-view>
                <cover-view class="preview-toggle-arrow">{{previewExpanded ? '⌃' : '⌄'}}</cover-view>
              </cover-view>
            </cover-view>
          </view>
          <view class="editor-summary">
            <text class="summary-primary">{{countText}}</text>
            <text class="summary-secondary">{{lengthText}}</text>
            <text class="summary-secondary">{{sizeText}}</text>
          </view>
        </view>
        <view wx:if="{{loading}}" class="section-loading board-loading">
          <view class="loading-ring" />
          <text>加载中...</text>
        </view>
      </view>

      <view wx:if="{{!loading}}" class="selected-actions">
        <text wx:if="{{selectedIndex >= 0}}">第 {{selectedNumber}} 颗</text>
        <text wx:else>共 {{totalBeadCount}} 颗 · 未选珠子</text>
        <button disabled="{{selectedIndex < 0}}" bindtap="decreaseSelectedSku">−</button>
        <button disabled="{{selectedIndex < 0}}" bindtap="increaseSelectedSku">＋</button>
        <button disabled="{{selectedIndex < 0}}" bindtap="replaceSelected">替换</button>
        <button disabled="{{selectedIndex < 0}}" bindtap="removeSelected">删除</button>
      </view>

      <block wx:if="{{!catalogInitialLoading}}">
        <view class="bead-search">
          <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索珠子" />
          <button class="favorite-filter {{favoritesOnly ? 'active' : ''}}" bindtap="toggleFavoritesOnly">{{favoritesOnly ? '♥ 喜欢' : '♡ 喜欢'}}</button>
          <button bindtap="searchCatalog">搜索</button>
        </view>

        <scroll-view scroll-x class="category-tabs">
          <button class="{{categoryId === 0 ? 'active' : ''}}" data-id="0" bindtap="chooseCategory">全部</button>
          <button
            wx:for="{{categories}}"
            wx:key="id"
            class="{{categoryId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="chooseCategory"
          >
            {{item.name}}
          </button>
        </scroll-view>

        <view class="tray-heading">
          <view>
            <text>挑选珠子</text>
            <text>点击珠子即可加入手串</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{catalogInitialLoading}}" class="section-loading catalog-loading">
      <view class="loading-ring" />
      <text>加载中...</text>
      <view class="catalog-loading-skeleton">
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
      </view>
    </view>

    <view wx:else class="bead-list-content">
      <view class="bead-grid">
          <view
            wx:for="{{visibleCatalog}}"
            wx:key="id"
            class="bead-card expanded"
          >
            <button class="bead-add" data-id="{{item.id}}" bindtap="addCatalogBead">
              <image wx:if="{{item.trayImageUrl}}" class="tray-bead tray-bead-image" src="{{item.trayImageUrl}}" mode="aspectFit" data-id="{{item.id}}" data-visual-key="{{item.visualVersion}}:{{item.trayImageUrl}}" binderror="onTrayImageError" />
              <view wx:else class="tray-bead" style="background: {{item.colorHex}};" />
              <text class="bead-name">{{item.name}}</text>
              <text class="bead-meta">{{item.diameterMm}} mm · ¥{{item.salePriceCents / 100}}</text>
            </button>
            <button class="tray-heart {{item.isFavorite ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleFavorite">{{item.isFavorite ? '♥' : '♡'}}</button>
          </view>
          <view wx:if="{{!visibleCatalog.length}}" class="empty-catalog">没有符合条件的珠子</view>
      </view>

      <view wx:if="{{quoteIssues.length}}" class="quote-issues">
        <text wx:for="{{quoteIssues}}" wx:key="code">{{item.message}}</text>
      </view>
    </view>

    <view class="editor-actions">
      <button loading="{{saving}}" disabled="{{checkingOut}}" bindtap="saveDraft">保存方案</button>
      <button loading="{{checkingOut}}" disabled="{{saving}}" bindtap="goCheckout">{{priceText}} · 去下单</button>
    </view>

  </block>
</view>
