<view class="diy-page">
  <view wx:if="{{loadFailed}}" class="page-state error-state">
    <text>{{errorMessage}}</text>
  </view>

  <block wx:else>
    <view wx:if="{{errorMessage}}" class="quote-issues">{{errorMessage}}</view>
    <view class="diy-controls {{previewExpanded ? '' : 'is-sticky'}}">
      <view wx:if="{{!loading}}" class="configuration-strip">
        <picker disabled="{{saving || checkingOut}}" range="{{wristOptionLabels}}" value="{{wristOptionIndex}}" bindchange="changeWrist">
          <button>腕围 {{wristCircumferenceText}}</button>
        </picker>
        <picker disabled="{{saving || checkingOut}}" range="{{fitTypeLabels}}" value="{{fitTypeIndex}}" bindchange="changeFitType">
          <button>{{fitTypeLabels[fitTypeIndex]}}</button>
        </picker>
        <picker disabled="{{saving || checkingOut}}" range="{{cordOptionNames}}" value="{{cordOptionIndex}}" bindchange="changeCord">
          <button>{{cordOptionNames[cordOptionIndex]}}</button>
        </picker>
      </view>

      <view class="canvas-panel {{previewExpanded ? 'is-expanded' : 'is-collapsed'}} {{loading ? 'is-loading' : ''}}">
        <view class="preview-layout">
          <view wx:if="{{!loading}}" class="preview-toolbar">
            <button class="preview-toggle" bindtap="togglePreview" aria-label="{{previewExpanded ? '收起预览' : '展开预览'}}">
              <text class="preview-toggle-label">{{previewExpanded ? '收起预览' : '展开预览'}}</text>
              <text class="preview-toggle-arrow">{{previewExpanded ? '⌃' : '⌄'}}</text>
            </button>
          </view>
          <view class="bracelet-canvas-viewport">
            <canvas
              id="bracelet-canvas"
              type="2d"
              class="bracelet-canvas"
              hidden="{{!previewExpanded}}"
              bindtouchstart="onCanvasTouchStart"
              bindtouchmove="onCanvasTouchMove"
              bindtouchend="onCanvasTouchEnd"
              bindtouchcancel="onCanvasTouchCancel"
            />
            <image
              wx:if="{{!previewExpanded && compactPreviewUrl}}"
              class="compact-preview-image"
              src="{{compactPreviewUrl}}"
              mode="aspectFit"
            />
          </view>
          <view class="editor-summary">
            <text class="summary-primary">{{countText}}</text>
            <text class="summary-secondary">{{lengthText}}</text>
            <text class="summary-secondary">{{sizeText}}</text>
          </view>
        </view>
        <view wx:if="{{loading}}" class="section-loading board-loading">
          <view class="loading-ring" />
          <text>加载中...</text>
        </view>
      </view>

      <view wx:if="{{!loading}}" class="selected-actions">
        <text wx:if="{{selectedIndex >= 0}}">第 {{selectedNumber}} 颗</text>
        <text wx:else>共 {{totalBeadCount}} 颗 · 未选珠子</text>
        <button disabled="{{selectedIndex < 0 || saving || checkingOut}}" bindtap="decreaseSelectedSku">−</button>
        <button disabled="{{selectedIndex < 0 || saving || checkingOut}}" bindtap="increaseSelectedSku">＋</button>
        <button disabled="{{selectedIndex < 0 || saving || checkingOut}}" bindtap="replaceSelected">替换</button>
        <button disabled="{{selectedIndex < 0 || saving || checkingOut}}" bindtap="removeSelected">删除</button>
      </view>

      <view wx:if="{{!loading}}" class="history-actions">
        <text>可撤销最近 50 步</text>
        <button disabled="{{!canUndo || saving || checkingOut}}" bindtap="undoEdit">撤销</button>
        <button disabled="{{!canRedo || saving || checkingOut}}" bindtap="redoEdit">重做</button>
      </view>

      <view wx:if="{{replacementIndex >= 0}}" class="replacement-panel">
        <text class="replacement-title">替换第 {{replacementIndex + 1}} 颗 · {{replacementOriginalName}}</text>
        <text wx:if="{{!replacementCandidateId}}">请在下方选择要换成的珠子</text>
        <block wx:else>
          <text>换成：{{replacementCandidateName}}</text>
          <text>{{replacementChangeText}}</text>
          <text wx:if="{{replacementStockText}}" class="material-warning">{{replacementStockText}}</text>
          <text>最终金额与适配结果以结算校验为准</text>
        </block>
        <view class="replacement-actions">
          <button bindtap="cancelReplacement">取消</button>
          <button disabled="{{!replacementCandidateId || saving || checkingOut}}" bindtap="confirmReplacement">确认替换</button>
        </view>
      </view>

      <view wx:if="{{materialWarnings.length}}" class="material-warnings">
        <text wx:for="{{materialWarnings}}" wx:key="*this">{{item}}</text>
      </view>

      <block wx:if="{{!catalogInitialLoading}}">
        <view class="bead-search">
          <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索珠子" />
          <button class="favorite-filter {{favoritesOnly ? 'active' : ''}}" bindtap="toggleFavoritesOnly">{{favoritesOnly ? '♥ 喜欢' : '♡ 喜欢'}}</button>
          <button bindtap="searchCatalog">搜索</button>
        </view>

        <view class="category-filter-row">
          <button class="category-all {{categoryId === 0 ? 'active' : ''}}" data-id="0" bindtap="chooseCategory">全部</button>
          <scroll-view scroll-x class="category-tabs">
            <button
              wx:for="{{categories}}"
              wx:key="id"
              class="{{categoryId === item.id ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="chooseCategory"
            >
              {{item.name}}
            </button>
          </scroll-view>
        </view>

        <view class="tray-heading">
          <view>
            <text>{{replacementIndex >= 0 ? '选择替换珠子' : '挑选珠子'}}</text>
            <text>{{replacementIndex >= 0 ? '选择后查看变化，再确认替换' : '点击珠子即可加入手串'}}</text>
            <text>库存仅供参考，尚未预留，下单时再次校验</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{catalogInitialLoading}}" class="section-loading catalog-loading">
      <view class="loading-ring" />
      <text>加载中...</text>
      <view class="catalog-loading-skeleton">
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
        <view class="skeleton-card" />
      </view>
    </view>

    <view wx:else class="bead-list-content">
      <view class="bead-grid">
          <view
            wx:for="{{visibleCatalog}}"
            wx:key="id"
            class="bead-card expanded {{replacementCandidateId === item.id ? 'replacement-candidate' : ''}}"
          >
            <button class="bead-add" disabled="{{loading || saving || checkingOut || item.unavailable}}" data-id="{{item.id}}" bindtap="addCatalogBead">
              <image wx:if="{{item.trayImageUrl}}" class="tray-bead tray-bead-image" src="{{item.trayImageUrl}}" mode="aspectFit" data-id="{{item.id}}" data-visual-key="{{item.visualVersion}}:{{item.trayImageUrl}}" binderror="onTrayImageError" />
              <view wx:else class="tray-bead" style="background: {{item.colorHex}};" />
              <text class="bead-name">{{item.name}}</text>
              <text class="bead-meta">{{item.diameterMm}} mm · ¥{{item.salePriceCents / 100}}</text>
              <text class="bead-meta">{{item.unavailable ? '已下架 · 可删除或换出' : item.availableQty !== null ? '当前可用 ' + item.availableQty + ' 颗' : '库存待校验'}}</text>
            </button>
            <button class="tray-heart {{item.isFavorite ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleFavorite">{{item.isFavorite ? '♥' : '♡'}}</button>
          </view>
          <view wx:if="{{!visibleCatalog.length}}" class="empty-catalog">没有符合条件的珠子</view>
      </view>

      <view wx:if="{{quoteIssues.length}}" class="quote-issues">
        <text wx:for="{{quoteIssues}}" wx:key="code">{{item.message}}</text>
      </view>
    </view>

    <view class="editor-actions">
      <button loading="{{saving}}" disabled="{{loading || saving || checkingOut}}" bindtap="saveDraft">保存方案</button>
      <button loading="{{checkingOut}}" disabled="{{loading || saving || checkingOut}}" bindtap="goCheckout">{{priceText}} · 去下单</button>
    </view>

  </block>
</view>
