page {
  background: #faf6f3;
}

.diy-page {
  position: relative;
  min-height: 100vh;
  padding: 16rpx 24rpx 158rpx;
  background: #faf6f3;
  box-sizing: border-box;
}

.diy-controls {
  padding-bottom: 6rpx;
  background: #faf6f3;
}

.diy-controls.is-sticky {
  position: -webkit-sticky;
  position: sticky;
  z-index: 12;
  top: 0;
  box-shadow: 0 12rpx 26rpx rgba(87, 54, 66, .06);
}

.section-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #4b3b42;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.loading-ring {
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid #ecdce2;
  border-top-color: #87465e;
  border-radius: 50%;
  animation: loading-spin .85s linear infinite;
  box-sizing: border-box;
}

.section-loading > text {
  margin-top: 20rpx;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}

.page-state {
  display: flex;
  min-height: 760rpx;
  align-items: center;
  justify-content: center;
  color: #8d8186;
  font-size: 26rpx;
}

.error-state {
  color: #a04d59;
}

.configuration-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.configuration-strip button {
  height: 64rpx;
  border-radius: 32rpx;
  color: #684353;
  font-size: 22rpx;
  line-height: 64rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(87, 54, 66, .08);
}

.canvas-panel {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background: #fffdfb;
  box-shadow: 0 18rpx 50rpx rgba(87, 54, 66, .09);
}

.canvas-panel.is-loading .bracelet-canvas,
.canvas-panel.is-loading .editor-summary {
  visibility: hidden;
}

.board-loading {
  position: absolute;
  z-index: 11;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: #fffdfb;
}

.preview-toolbar {
  position: absolute;
  z-index: 10;
  top: 14rpx;
  right: 16rpx;
}

.preview-toggle {
  display: flex;
  width: 154rpx;
  height: 58rpx;
  padding: 0 16rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dfbdc9;
  border-radius: 29rpx;
  color: #754657;
  font-size: 21rpx;
  line-height: 58rpx;
  background: rgba(255, 255, 255, .92);
  box-sizing: border-box;
}

.preview-toggle-label {
  line-height: 56rpx;
}

.preview-toggle-arrow {
  margin-left: 8rpx;
  line-height: 52rpx;
}

.preview-layout {
  position: relative;
  height: 792rpx;
  min-width: 0;
  overflow: hidden;
}

.bracelet-canvas-viewport {
  width: 100%;
  height: 660rpx;
  overflow: hidden;
}

.bracelet-canvas {
  display: block;
  width: 100%;
  height: 660rpx;
}

.canvas-panel.is-collapsed .preview-layout {
  height: 196rpx;
}

.canvas-panel.is-collapsed .bracelet-canvas-viewport {
  width: 226rpx;
  height: 196rpx;
}

.compact-preview-image {
  display: block;
  width: 226rpx;
  height: 196rpx;
  background: #fffdfb;
}

.editor-summary {
  position: absolute;
  top: 660rpx;
  right: 0;
  left: 0;
  display: grid;
  height: 132rpx;
  grid-template-columns: 1fr;
  gap: 8rpx;
  padding: 0 28rpx 22rpx;
  overflow: hidden;
  color: #6a5d63;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.editor-summary text:first-child {
  color: #3d3036;
  font-size: 34rpx;
  font-weight: 700;
}

.canvas-panel.is-collapsed .editor-summary {
  top: 0;
  right: 0;
  left: 226rpx;
  height: 196rpx;
  align-items: flex-start;
  padding: 34rpx 20rpx 14rpx 4rpx;
  overflow: visible;
  text-align: left;
}

.selected-actions,
.bead-search,
.editor-actions {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.selected-actions {
  margin: 10rpx 0;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #fff;
}

.selected-actions text {
  flex: 1;
  color: #4b3b42;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-actions button {
  min-width: 78rpx;
  height: 54rpx;
  border-radius: 27rpx;
  color: #754657;
  font-size: 22rpx;
  line-height: 54rpx;
  background: #f4e7ec;
}

.selected-actions button[disabled] {
  color: #b7a9ae;
  background: #f6f1f3;
}

.category-tabs {
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.category-tabs button {
  display: inline-block;
  width: auto;
  min-width: 130rpx;
  height: 58rpx;
  margin-right: 10rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  color: #75686d;
  font-size: 22rpx;
  line-height: 58rpx;
  background: #fff;
}

.category-tabs .active {
  color: #fff;
  background: #754657;
}

.bead-search {
  margin-bottom: 8rpx;
}

.bead-search input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  color: #4a3c42;
  font-size: 24rpx;
  background: #fff;
}

.bead-search button {
  width: 130rpx;
  height: 64rpx;
  border-radius: 32rpx;
  color: #fff;
  font-size: 23rpx;
  line-height: 64rpx;
  background: #754657;
}

.bead-search .favorite-filter {
  width: 128rpx;
  border: 2rpx solid #e6b9ca;
  color: #a94f73;
  background: #fff6f9;
}

.bead-search .favorite-filter.active {
  border-color: #c65380;
  color: #fff;
  background: #c65380;
}

.bead-tray {
  padding: 4rpx 0 14rpx;
  white-space: nowrap;
}

.bead-list-content {
  min-height: 180rpx;
  box-sizing: border-box;
}

.catalog-loading {
  position: relative;
  min-height: 520rpx;
  padding: 64rpx 0 28rpx;
  justify-content: flex-start;
  background: #faf6f3;
}

.catalog-loading-skeleton {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 52rpx;
  opacity: .5;
}

.skeleton-card {
  height: 218rpx;
  border-radius: 24rpx;
  background: linear-gradient(100deg, #f0e9e6 20%, #fff 42%, #f0e9e6 64%);
  background-size: 240% 100%;
  animation: skeleton-shimmer 1.25s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}

.bead-list-content.is-expanded {
  padding-bottom: 16rpx;
}

.tray-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 6rpx;
}

.tray-heading view text {
  display: block;
}

.tray-heading view text:first-child {
  color: #49363e;
  font-size: 28rpx;
  font-weight: 700;
}

.tray-heading view text:last-child {
  margin-top: 5rpx;
  color: #a08c94;
  font-size: 19rpx;
}

.tray-heading button {
  width: auto;
  min-width: 194rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #dfbdc9;
  border-radius: 29rpx;
  color: #87465e;
  font-size: 21rpx;
  line-height: 58rpx;
  white-space: nowrap;
  background: #fff8fa;
}

.bead-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 6rpx 0 18rpx;
}

.bead-card {
  position: relative;
  display: inline-block;
  width: 180rpx;
  height: 158rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.bead-card.expanded {
  display: block;
  width: 100%;
  height: 218rpx;
  margin: 0;
}

.bead-card.expanded .bead-add {
  width: 100%;
  height: 218rpx;
  padding: 16rpx 8rpx 12rpx;
  box-sizing: border-box;
}

.bead-card.expanded .tray-bead {
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 8rpx;
}

.bead-card.expanded .bead-name {
  display: block;
  overflow: hidden;
  width: 100%;
  color: #46383e;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bead-card.expanded .bead-meta {
  display: block;
  margin-top: 4rpx;
  color: #9b858e;
  font-size: 17rpx;
}

.empty-catalog {
  grid-column: 1 / -1;
  padding: 70rpx 0;
  border-radius: 24rpx;
  color: #9b8a90;
  font-size: 22rpx;
  text-align: center;
  background: rgba(255, 255, 255, .72);
}

.bead-card .bead-add {
  display: inline-flex;
  width: 180rpx;
  height: 158rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 0;
  border-radius: 24rpx;
  color: #4a3c42;
  font-size: 20rpx;
  line-height: 1.35;
  background: #fff;
}

.bead-card .tray-heart {
  position: absolute;
  z-index: 3;
  top: 8rpx;
  right: 8rpx;
  width: 46rpx;
  min-width: 0;
  height: 46rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #a98d97;
  font-size: 28rpx;
  line-height: 46rpx;
  background: rgba(255,255,255,.92);
}

.bead-card .tray-heart.active {
  color: #df5d91;
  background: #fff0f5;
}

.tray-bead {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 12rpx;
  border: 6rpx solid rgba(255, 255, 255, .8);
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(87, 54, 66, .18);
}

.tray-bead-image {
  display: block;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
}

.quote-issues {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 6rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  color: #9b4e58;
  font-size: 22rpx;
  background: #fff1f2;
}

.editor-actions {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eadfdb;
  background: rgba(255, 253, 251, .97);
}

.editor-actions button {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  color: #754657;
  font-size: 24rpx;
  line-height: 76rpx;
  background: #f2e5ea;
}

.editor-actions button:first-child {
  flex: 0 0 34%;
}

.editor-actions button:last-child {
  min-width: 0;
  color: #fff;
  white-space: nowrap;
  background: #754657;
}
