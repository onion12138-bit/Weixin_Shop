.diy-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  background: #faf6f3;
  box-sizing: border-box;
}

.page-state {
  display: flex;
  min-height: 760rpx;
  align-items: center;
  justify-content: center;
  color: #8d8186;
  font-size: 26rpx;
}

.error-state {
  color: #a04d59;
}

.configuration-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.configuration-strip button {
  height: 70rpx;
  border-radius: 35rpx;
  color: #684353;
  font-size: 23rpx;
  line-height: 70rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(87, 54, 66, .08);
}

.canvas-panel {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background: #fffdfb;
  box-shadow: 0 18rpx 50rpx rgba(87, 54, 66, .09);
}

.bracelet-canvas {
  display: block;
  width: 100%;
  height: 660rpx;
}

.history-actions {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 12rpx;
}

.history-actions button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  color: #754657;
  font-size: 30rpx;
  line-height: 64rpx;
  background: rgba(255, 255, 255, .9);
}

.editor-summary {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  padding: 0 32rpx 30rpx;
  color: #6a5d63;
  font-size: 24rpx;
  text-align: center;
}

.editor-summary text:first-child {
  color: #3d3036;
  font-size: 34rpx;
  font-weight: 700;
}

.price-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 22rpx 0;
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
  color: #693e50;
  font-size: 34rpx;
  font-weight: 700;
  background: #f1e1e7;
}

.price-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  background: #754657;
}

.selected-actions,
.bead-search,
.editor-actions {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.selected-actions {
  margin-bottom: 22rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #fff;
}

.selected-actions text {
  flex: 1;
  color: #4b3b42;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-actions button {
  min-width: 82rpx;
  height: 58rpx;
  border-radius: 29rpx;
  color: #754657;
  font-size: 22rpx;
  line-height: 58rpx;
  background: #f4e7ec;
}

.category-tabs {
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.category-tabs button {
  display: inline-block;
  width: auto;
  min-width: 130rpx;
  height: 62rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border-radius: 31rpx;
  color: #75686d;
  font-size: 22rpx;
  line-height: 62rpx;
  background: #fff;
}

.category-tabs .active {
  color: #fff;
  background: #754657;
}

.bead-search {
  margin-bottom: 18rpx;
}

.bead-search input {
  flex: 1;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  color: #4a3c42;
  font-size: 24rpx;
  background: #fff;
}

.bead-search button {
  width: 130rpx;
  height: 68rpx;
  border-radius: 34rpx;
  color: #fff;
  font-size: 23rpx;
  line-height: 68rpx;
  background: #754657;
}

.bead-tray {
  padding: 8rpx 0 24rpx;
  white-space: nowrap;
}

.bead-tray button {
  display: inline-flex;
  width: 180rpx;
  height: 158rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 24rpx;
  color: #4a3c42;
  font-size: 20rpx;
  line-height: 1.35;
  background: #fff;
}

.tray-bead {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 12rpx;
  border: 6rpx solid rgba(255, 255, 255, .8);
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(87, 54, 66, .18);
}

.quote-issues {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 8rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  color: #9b4e58;
  font-size: 22rpx;
  background: #fff1f2;
}

.editor-actions {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eadfdb;
  background: rgba(255, 253, 251, .97);
}

.editor-actions button {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  color: #754657;
  font-size: 24rpx;
  line-height: 76rpx;
  background: #f2e5ea;
}

.editor-actions button:last-child {
  color: #fff;
  background: #754657;
}
