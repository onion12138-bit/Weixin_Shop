.diy-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  color: #46393f;
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
  background: #fff8fa;
  box-sizing: border-box;
}

button {
  padding: 0;
  border: 0;
}

button::after {
  display: none;
}

.page-state {
  display: flex;
  min-height: 760rpx;
  align-items: center;
  justify-content: center;
  color: #8d8186;
  font-size: 26rpx;
}

.error-state {
  color: #a04d59;
}

.configuration-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.configuration-strip button {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid rgba(238, 214, 224, .64);
  border-radius: 44rpx;
  color: #88596d;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 88rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 8rpx 24rpx rgba(174, 101, 131, .08);
}

.canvas-panel {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(236, 205, 217, .72);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 18rpx 48rpx rgba(174, 101, 131, .10);
}

.preview-toolbar {
  box-sizing: border-box;
}

.canvas-panel.is-expanded .preview-toolbar {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100rpx;
  padding: 6rpx 12rpx;
  align-items: center;
  justify-content: space-between;
}

.canvas-panel.is-collapsed .preview-toolbar {
  position: absolute;
  z-index: 5;
  top: 20rpx;
  right: 20rpx;
}

.preview-toggle {
  display: flex;
  min-width: 170rpx;
  height: 88rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(230, 208, 216, .76);
  border-radius: 44rpx;
  color: #725c65;
  font-size: 22rpx;
  line-height: 1;
  background: rgba(255, 253, 254, .94);
  box-shadow: 0 8rpx 20rpx rgba(126, 78, 98, .07);
}

.preview-chevron {
  width: 28rpx;
  height: 28rpx;
}

.preview-layout {
  min-width: 0;
}

.bracelet-canvas {
  display: block;
  width: 100%;
}

.canvas-panel.is-expanded .bracelet-canvas {
  height: 520rpx;
}

.canvas-panel.is-collapsed .preview-layout {
  display: grid;
  grid-template-columns: 300rpx minmax(0, 1fr);
  min-height: 220rpx;
  align-items: center;
}

.canvas-panel.is-collapsed .bracelet-canvas {
  height: 210rpx;
}

.editor-summary {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 32rpx 30rpx;
  color: #7d6a72;
  font-size: 24rpx;
  text-align: left;
  box-sizing: border-box;
}

.canvas-panel.is-collapsed .editor-summary {
  align-items: flex-start;
  padding: 58rpx 24rpx 22rpx 10rpx;
  text-align: left;
}

.count-text {
  color: #3d3036;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.length-stack {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: #74636a;
  font-size: 23rpx;
  line-height: 1.45;
}

.history-actions {
  display: flex;
  gap: 4rpx;
}

.history-actions button {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: transparent;
}

.history-actions image {
  width: 34rpx;
  height: 34rpx;
}

.history-actions button[disabled] {
  opacity: .32;
}

.price-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 22rpx 0;
  padding: 24rpx 30rpx;
  border: 1rpx solid rgba(239, 208, 220, .56);
  border-radius: 24rpx;
  color: #75475a;
  font-size: 34rpx;
  font-weight: 700;
  background: #f8e8ee;
}

.price-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  background: #8b4e67;
}

.selected-actions,
.bead-search,
.editor-actions {
  display: flex;
  align-items: center;
}

.selected-actions {
  justify-content: flex-end;
  gap: 4rpx;
  margin-bottom: 22rpx;
  padding: 0 10rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .94);
}

.selected-actions button {
  position: relative;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: transparent;
}

.selected-actions button::before {
  position: absolute;
  width: 84rpx;
  height: 58rpx;
  border-radius: 29rpx;
  background: #f8eaf0;
  content: "";
}

.selected-actions image {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
}

.category-tabs {
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.category-tabs button {
  display: inline-block;
  width: auto;
  min-width: 132rpx;
  height: 88rpx;
  margin-right: 14rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(238, 214, 224, .58);
  border-radius: 44rpx;
  color: #75686d;
  font-size: 23rpx;
  line-height: 88rpx;
  background: rgba(255, 255, 255, .94);
}

.category-tabs .active {
  border-color: #8a4e66;
  color: #fff;
  background: #8a4e66;
}

.bead-search {
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.bead-search input {
  min-width: 0;
  height: 88rpx;
  flex: 1;
  padding: 0 26rpx;
  border: 1rpx solid rgba(239, 216, 225, .62);
  border-radius: 44rpx;
  color: #4a3c42;
  font-size: 24rpx;
  background: rgba(255, 255, 255, .96);
  box-sizing: border-box;
}

.bead-search button {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 23rpx;
}

.favorite-filter {
  width: 116rpx;
  gap: 6rpx;
  border: 1rpx solid rgba(238, 197, 214, .76);
  color: #9a6178;
  background: #fff;
}

.favorite-filter image {
  width: 28rpx;
  height: 28rpx;
}

.favorite-filter.active {
  border-color: #f176a8;
  color: #fff;
  background: #f176a8;
}

.favorite-filter.active image,
.favorite-button.active image {
  filter: brightness(0) invert(1);
}

.search-button {
  width: 112rpx;
  color: #fff;
  background: #8a4e66;
}

.bead-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.bead-card {
  position: relative;
  display: flex;
  min-width: 0;
  height: 220rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 22rpx 10rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(238, 216, 224, .56);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 10rpx 28rpx rgba(174, 101, 131, .07);
  box-sizing: border-box;
}

.favorite-button {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: transparent;
}

.favorite-button::before {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(235, 208, 219, .78);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .92);
  content: "";
  box-sizing: border-box;
}

.favorite-button.active::before {
  border-color: #f176a8;
  background: #f176a8;
}

.favorite-button image {
  position: relative;
  z-index: 1;
  width: 26rpx;
  height: 26rpx;
}

.tray-bead {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 8rpx;
  flex: none;
  border: 6rpx solid rgba(255, 255, 255, .82);
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(87, 54, 66, .16);
  box-sizing: border-box;
}

.tray-bead-image {
  display: block;
  background: transparent;
}

.bead-name,
.bead-price {
  display: block;
  width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bead-name {
  color: #59484f;
  font-size: 20rpx;
  line-height: 1.45;
}

.bead-price {
  color: #a9617e;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
}

.catalog-empty {
  display: flex;
  min-height: 240rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(222, 183, 199, .72);
  border-radius: 28rpx;
  color: #a48390;
  font-size: 24rpx;
  background: rgba(255, 255, 255, .58);
}

.quote-issues {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  color: #9b4e58;
  font-size: 22rpx;
  background: #fff1f2;
}

.editor-actions {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 14rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0dfe6;
  background: rgba(255, 250, 252, .97);
  box-shadow: 0 -10rpx 30rpx rgba(150, 87, 113, .06);
}

.editor-actions button {
  height: 88rpx;
  flex: 1;
  border-radius: 44rpx;
  color: #8a5269;
  font-size: 24rpx;
  line-height: 88rpx;
  background: #f8e8ee;
}

.editor-actions button:last-child {
  color: #fff;
  background: #8a4e66;
}
