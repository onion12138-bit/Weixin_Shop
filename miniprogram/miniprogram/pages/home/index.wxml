<view class="page-shell">
  <view class="hero">
    <view class="hero-copy">
      <text class="eyebrow">HANDMADE FOR YOU</text>
      <text class="title">一串珠子，\n一种属于你的节奏。</text>
      <text class="summary">
        从天然水晶到温润木珠，自由挑选、组合和保存你的手串设计。
      </text>
      <view class="hero-actions">
        <button class="hero-button" bindtap="openCatalog">开始选珠</button>
        <navigator class="hero-link" url="/pages/diy/editor">直接 DIY</navigator>
        <navigator class="hero-link secondary" url="/pages/diy/schemes">我的方案</navigator>
      </view>
    </view>
    <view class="bracelet-art" aria-hidden="true">
      <view class="orbit">
        <view wx:for="{{orbitBeads}}" wx:key="*this" class="bead bead-{{item}}" />
      </view>
      <view class="center-seal">拾珠</view>
    </view>
  </view>

  <view class="feature-row">
    <view wx:for="{{features}}" wx:key="label" class="feature-item">
      <text class="feature-value">{{item.value}}</text>
      <text class="feature-label">{{item.label}}</text>
    </view>
  </view>

  <view class="ai-consultation-card" bindtap="openRecommendation">
    <image src="/assets/images/ai-water-guide.png" mode="aspectFill" />
    <view class="ai-card-copy">
      <text class="section-kicker">AI BRACELET GUIDE</text>
      <text class="ai-card-title">AI 灵感咨询</text>
      <text class="ai-card-summary">从生日、偏好与佩戴场景出发，获得一套可继续 DIY 的手串灵感。</text>
      <text class="ai-card-link">开始咨询 →</text>
    </view>
  </view>

  <view class="journey-card">
    <view>
      <text class="section-kicker">HOW IT WORKS</text>
      <text class="section-title">三步做出你的手串</text>
    </view>
    <view class="steps">
      <view class="step">
        <text>01</text>
        <view><text class="step-title">挑选珠子</text><text>按材质、颜色和尺寸浏览</text></view>
      </view>
      <view class="step">
        <text>02</text>
        <view><text class="step-title">自由搭配</text><text>调整顺序并查看实时价格</text></view>
      </view>
      <view class="step">
        <text>03</text>
        <view><text class="step-title">保存方案</text><text>确认后进入订单与制作</text></view>
      </view>
    </view>
  </view>
</view>
