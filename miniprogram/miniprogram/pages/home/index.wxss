.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: #351447;
  background: #fff8fa;
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 0;
  color: inherit;
  font: inherit;
  line-height: normal;
  background: transparent;
}

button::after {
  border: 0;
}

.hero-section {
  position: relative;
  min-height: 500rpx;
  margin: 16rpx 14rpx 0;
  overflow: hidden;
  border-radius: 54rpx 54rpx 12rpx 12rpx;
  background: #fff0f4;
  box-shadow: 0 18rpx 46rpx rgba(223, 132, 165, .14);
}

.hero-background {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: .78;
}

.hero-image {
  position: absolute;
  z-index: 1;
  right: -100rpx;
  bottom: -115rpx;
  width: 480rpx;
  opacity: .86;
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding: 50rpx 0 28rpx 46rpx;
}

.hero-title-row {
  display: flex;
  align-items: flex-start;
}

.hero-title {
  display: flex;
  width: 440rpx;
  flex-direction: column;
  color: #351043;
  font-family: "Songti SC", "STSong", serif;
  font-size: 50rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.title-sparkle {
  width: 42rpx;
  height: 42rpx;
  margin: 18rpx 0 0 -24rpx;
}

.hero-summary {
  display: block;
  width: 460rpx;
  margin-top: 18rpx;
  color: #7d7077;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  width: 264rpx;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 24rpx;
}

.quick-action {
  display: flex;
  width: 264rpx;
  height: 60rpx;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid rgba(109, 69, 120, .09);
  border-radius: 38rpx;
  color: #452357;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, .9);
  box-shadow: 0 10rpx 26rpx rgba(137, 84, 111, .09);
}

.quick-action text {
  flex: 1;
  text-align: left;
}

.quick-action .action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.quick-action .action-arrow {
  width: 28rpx;
  height: 28rpx;
}

.primary-action {
  border-color: #f16fa5;
  color: #fff;
  background: #f16fa5;
  box-shadow: 0 14rpx 30rpx rgba(233, 81, 143, .26);
}

.page-section {
  margin: 28rpx 28rpx 0;
}

.section-header {
  display: flex;
  min-height: 46rpx;
  align-items: center;
  justify-content: space-between;
}

.mood-header {
  padding: 0 2rpx 12rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  color: #36154a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.section-heading image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
}

.refresh-button,
.section-link {
  display: flex;
  height: 50rpx;
  align-items: center;
  color: #82777c;
  font-size: 23rpx;
}

.refresh-button image,
.section-link image {
  width: 29rpx;
  height: 29rpx;
  margin-left: 9rpx;
}

.product-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.mood-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(4, 160rpx);
  gap: 18rpx;
  justify-content: center;
  padding-bottom: 4rpx;
}

.mood-scroll {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.mood-card {
  display: flex;
  box-sizing: border-box;
  width: 160rpx;
  min-width: 160rpx;
  height: 160rpx;
  flex-direction: column;
  align-items: center;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid rgba(236, 211, 220, .58);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(117, 75, 93, .09);
}

.mood-image-shell {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.mood-image-shell image {
  display: block;
  width: 100%;
  height: 100%;
}

.wish-diy-guide {
  display: flex;
  box-sizing: border-box;
  min-height: 88rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 13rpx 14rpx;
  border: 1rpx solid rgba(239, 176, 201, .58);
  border-radius: 24rpx;
  background: #fff0f5;
  box-shadow: 0 10rpx 24rpx rgba(213, 107, 151, .08);
}

.wish-diy-icon {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 auto;
  margin-right: 12rpx;
}

.wish-diy-copy {
  min-width: 0;
  flex: 1;
}

.wish-diy-title,
.wish-diy-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-diy-title {
  color: #5c245f;
  font-size: 23rpx;
  font-weight: 600;
}

.wish-diy-summary {
  margin-top: 5rpx;
  color: #967c89;
  font-size: 18rpx;
}

.wish-diy-badge {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 17rpx;
  font-weight: 600;
  background: #ed77a6;
}

.product-section .section-header,
.scheme-section .section-header {
  padding: 0 2rpx 12rpx;
}

.product-scroll {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.product-card {
  width: 160rpx;
  min-width: 160rpx;
  overflow: hidden;
  border: 1rpx solid rgba(236, 211, 220, .58);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(117, 75, 93, .09);
}

.product-image {
  display: block;
  width: 160rpx;
  height: 160rpx;
}

.product-copy {
  padding: 12rpx 12rpx 11rpx;
}

.product-name {
  display: block;
  overflow: hidden;
  color: #351447;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  display: block;
  margin-top: 9rpx;
  color: #8b5670;
  font-size: 19rpx;
  font-weight: 500;
}

.product-state {
  display: flex;
  box-sizing: border-box;
  min-height: 226rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(206, 160, 180, .6);
  border-radius: 28rpx;
  color: #9b7f8c;
  font-size: 22rpx;
  background: rgba(255, 255, 255, .58);
}

.product-state-error {
  color: #a95878;
}

.scheme-card {
  position: relative;
  display: flex;
  min-height: 160rpx;
  align-items: center;
  padding: 14rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(237, 211, 221, .68);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 15rpx 38rpx rgba(126, 78, 98, .09);
}

.scheme-bracelet-preview {
  position: relative;
  box-sizing: border-box;
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border: 1rpx solid rgba(237, 211, 221, .56);
  border-radius: 23rpx;
  background: #fffafc;
}

.scheme-preview-bead {
  position: absolute;
  display: block;
  filter: drop-shadow(0 3rpx 3rpx rgba(79, 49, 60, .16));
}

.scheme-copy {
  align-self: flex-start;
  min-width: 0;
  flex: 1;
  padding: 6rpx 76rpx 50rpx 18rpx;
}

.scheme-title-row {
  display: flex;
  align-items: center;
}

.scheme-title {
  overflow: hidden;
  color: #351447;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scheme-badge {
  flex: 0 0 auto;
  margin-left: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: 16rpx;
  color: #ed6ca0;
  font-size: 16rpx;
  background: #ffedf3;
}

.scheme-crystals,
.scheme-date {
  display: block;
  overflow: hidden;
  color: #85787d;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scheme-crystals {
  margin-top: 10rpx;
}

.scheme-date {
  margin-top: 6rpx;
}

.continue-button {
  position: absolute;
  right: 16rpx;
  bottom: 14rpx;
  width: 136rpx;
  height: 52rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 21rpx;
  line-height: 52rpx;
  background: #f176a8;
}

.scheme-state {
  display: flex;
  box-sizing: border-box;
  min-height: 150rpx;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  border: 1rpx dashed rgba(206, 160, 180, .6);
  border-radius: 30rpx;
  color: #8f7a84;
  font-size: 21rpx;
  background: rgba(255, 255, 255, .64);
}

.scheme-state button {
  min-width: 128rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 20rpx;
  line-height: 48rpx;
  background: #ed77a6;
}

.scheme-state-error {
  color: #a95878;
}

.share-card {
  position: relative;
  display: flex;
  min-height: 120rpx;
  align-items: center;
  margin: 20rpx 28rpx 0;
  padding: 8rpx 14rpx 8rpx 126rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #ffedf3;
  box-shadow: 0 14rpx 34rpx rgba(221, 109, 152, .12);
}

.gift-image {
  position: absolute;
  left: 4rpx;
  bottom: -8rpx;
  width: 132rpx;
  height: 132rpx;
}

.share-copy {
  min-width: 0;
  flex: 1;
  padding-right: 16rpx;
}

.share-title,
.share-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-title {
  color: #7b2457;
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 600;
}

.share-summary {
  margin-top: 8rpx;
  color: #9b7486;
  font-size: 18rpx;
}

.share-button {
  display: flex;
  width: 128rpx;
  height: 52rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  color: #fff;
  font-size: 21rpx;
  background: #ef74a7;
}

.share-button image {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.bottom-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  height: calc(72rpx + env(safe-area-inset-bottom));
  align-items: flex-start;
  padding: 6rpx 36rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(226, 208, 214, .82);
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 -10rpx 34rpx rgba(107, 80, 91, .08);
}

.nav-item {
  display: flex;
  height: 66rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a7d82;
  font-size: 20rpx;
}

.nav-item image {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 3rpx;
}

.nav-item.active {
  color: #ef649a;
  font-weight: 600;
}

.action-pressed,
.card-pressed {
  opacity: .84;
  transform: scale(.985);
}

.soft-pressed {
  opacity: .68;
}
