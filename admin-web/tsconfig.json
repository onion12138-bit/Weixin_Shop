{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "types": ["vite/client", "vitest/globals", "node"],
    "lib": ["ES2022", "DOM", "ESNext.Disposable"]
  },
